<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .Title }}</title>
    <link rel="stylesheet" href="{{ .StylesheetURL }}">
</head>
<body>
<header class="as-header">
    <div class="mx-auto flex max-w-2xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4">
        <p><a href="{{ path "/" }}" class="font-semibold no-underline">{{ .SiteTitle }}</a></p>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted [&_a]:no-underline [&_a:hover]:text-fg">
            {{ if .CurrentUser }}
                <span class="hidden sm:inline">Signed in as {{ with .CurrentUser.Name }}{{ . }}{{ else }}{{ .CurrentUser.Username }}{{ end }}</span>
                {{ if .CanSeeAdmin }}<a href="{{ path "/admin" }}">Admin</a>{{ end }}
                <a href="{{ path "/account" }}">Account</a>
                <a href="{{ .PasswordURL }}">Password</a>
                <a href="{{ .LogoutURL }}">Sign out</a>
            {{ else }}
                <a href="{{ .LoginURL }}">Sign in</a>
            {{ end }}
        </nav>
    </div>
</header>
<main class="mx-auto flex max-w-2xl flex-col gap-6 px-4 py-10">
    {{ with .AdminTabs }}
        <nav aria-label="Administration" class="as-tabs">
            {{ range . }}<a href="{{ .URL }}" class="as-tab"{{ if .Active }} aria-current="page"{{ end }}>{{ .Label }}</a>{{ end }}
        </nav>
    {{ end }}
    <h1>{{ .Title }}</h1>
    {{ if .ErrorMessage }}<p role="alert" class="as-alert variant-danger">{{ .ErrorMessage }}</p>{{ end }}
    {{ if .Notice }}<p role="status" class="as-alert variant-success">{{ .Notice }}</p>{{ end }}
    {{ template "content" .Content }}
</main>
</body>
</html>

{{ define "status-badge" }}<span class="as-badge {{ if eq . "published" }}variant-success{{ else if eq . "draft" }}variant-info{{ end }}">{{ . }}</span>{{ end }}
