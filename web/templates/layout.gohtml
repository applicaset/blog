<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .Title }}</title>
    <link rel="stylesheet" href="{{ .StylesheetURL }}">
    {{/* Deferred, so the page renders and works before the script runs, and without it. */}}
    <script src="{{ .ScriptURL }}" defer></script>
</head>
<body>
<header class="as-header">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4">
        <p><a href="{{ path "/" }}" class="font-semibold no-underline">{{ .SiteTitle }}</a></p>
        <div class="flex items-center gap-4">
            <nav class="flex items-center gap-4 text-muted [&_a]:no-underline [&_a:hover]:text-fg">
                {{ if .CurrentUser }}
                    {{ if .CanSeeAdmin }}<a href="{{ path "/admin" }}">Admin</a>{{ end }}
                {{ else }}
                    <a href="{{ .LoginURL }}">Sign in</a>
                {{ end }}
            </nav>
            {{ if .CurrentUser }}{{ template "account-menu" . }}{{ end }}
        </div>
    </div>
</header>
<main class="mx-auto flex max-w-5xl flex-col gap-6 px-4 py-10">
    {{ with .AdminTabs }}
        <nav aria-label="Administration" class="as-tabs">
            {{ range . }}<a href="{{ .URL }}" class="as-tab"{{ if .Active }} aria-current="page"{{ end }}>{{ .Label }}</a>{{ end }}
        </nav>
    {{ end }}
    <h1>{{ .Title }}</h1>
    {{ if .ErrorMessage }}<p role="alert" class="as-alert variant-danger">{{ .ErrorMessage }}</p>{{ end }}
    {{ if .Notice }}<p role="status" class="as-alert variant-success">{{ .Notice }}</p>{{ end }}
    {{ template "content" .Content }}
</main>
</body>
</html>

{{ define "account-menu" }}
<div class="as-menu-root">
    <button type="button" class="as-menu-trigger" popovertarget="account-menu" aria-label="Account menu">
        <span class="as-avatar" aria-hidden="true">{{ initials .CurrentUser.Name .CurrentUser.Username }}</span>
    </button>
    <div id="account-menu" popover class="as-menu">
        <div class="as-menu-header">
            <p class="font-medium">{{ with .CurrentUser.Name }}{{ . }}{{ else }}{{ .CurrentUser.Username }}{{ end }}</p>
            <p class="text-sm text-muted">@{{ .CurrentUser.Username }}</p>
        </div>
        <hr class="as-menu-separator">
        <nav aria-label="Account">
            <a href="{{ path "/account" }}" class="as-menu-item">Edit account</a>
            <a href="{{ .PasswordURL }}" class="as-menu-item">Change password</a>
            <hr class="as-menu-separator">
            <a href="{{ .LogoutURL }}" class="as-menu-item">Sign out</a>
        </nav>
    </div>
</div>
{{ end }}

{{ define "status-badge" }}<span class="as-badge {{ if eq . "published" }}variant-success{{ else if eq . "draft" }}variant-info{{ end }}">{{ . }}</span>{{ end }}
