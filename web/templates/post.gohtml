{{ define "content" }}
<article class="flex max-w-prose flex-col gap-5">
    {{ with .Post.PublishedAt }}<p class="text-sm text-muted"><time datetime="{{ .Format "2006-01-02" }}">{{ .Format "2 January 2006" }}</time></p>{{ end }}
    {{ if ne .Post.Status "published" }}<p class="as-alert variant-warning">This post is a {{ .Post.Status }}.</p>{{ end }}
    <div class="flex flex-col gap-5 text-base leading-7 sm:text-lg sm:leading-8">{{ .Body }}</div>
</article>

{{ if .Discussion }}
    {{ $page := . }}
    <section id="comments" aria-labelledby="comments-heading" class="flex max-w-prose flex-col gap-4 border-t border-border pt-6">
        <h2 id="comments-heading">Comments</h2>
        {{ if .Comments }}
            <ol class="flex flex-col gap-3">
                {{ range $c := .Comments }}
                    <li>
                        <article id="comment-{{ $c.ID }}" class="as-card blog-comment flex flex-col gap-2" style="--depth: {{ $c.VisualDepth }}" aria-label="Comment by {{ $c.Author }}">
                            <header class="flex flex-wrap items-center gap-2 text-sm text-muted">
                                <span class="font-medium text-fg">{{ $c.Author }}</span>
                                <time datetime="{{ $c.CreatedAt.Format "2006-01-02T15:04:05Z07:00" }}">{{ $c.CreatedAt.Format "2 January 2006, 15:04" }}</time>
                                {{ if and $c.EditedAt (not $c.DeletedAt) }}<span>edited</span>{{ end }}
                                {{ with $c.ReplyingTo }}<span>replying to {{ . }}</span>{{ end }}
                            </header>
                            {{ if $c.Edit }}
                                <form method="post" action="{{ $page.URL }}/comments/{{ $c.ID }}" class="flex flex-col gap-2">
                                    <input type="hidden" name="revision" value="{{ $c.Edit.Revision }}">
                                    <textarea name="body" rows="3" dir="auto" maxlength="10000" required autofocus class="as-input" aria-label="Edit comment">{{ $c.Edit.Body }}</textarea>
                                    {{ with $c.Edit.Error }}<p role="alert" class="as-alert variant-danger">{{ . }}</p>{{ end }}
                                    <div class="flex flex-wrap items-start gap-2">
                                        <button type="submit" class="as-button size-sm">Save</button>
                                        <a href="{{ $page.URL }}#comment-{{ $c.ID }}" hx-get="{{ $page.URL }}" hx-target="#comment-{{ $c.ID }}" hx-select="#comment-{{ $c.ID }}" hx-swap="outerHTML" class="as-button size-sm variant-outlined">Cancel</a>
                                    </div>
                                </form>
                            {{ else if $c.DeletedAt }}
                                <p class="text-muted italic">This comment was deleted.</p>
                            {{ else }}
                                <p class="whitespace-pre-wrap" dir="auto">{{ $c.Body }}</p>
                                {{ if or $page.CanComment $c.Mine }}
                                    <div class="flex flex-wrap items-start gap-2">
                                        {{ if $page.CanComment }}
                                            <details>
                                                <summary class="as-button size-sm variant-outlined">Reply</summary>
                                                <form method="post" action="{{ $page.URL }}/comments" class="mt-2 flex flex-col gap-2">
                                                    <input type="hidden" name="parent" value="{{ $c.ID }}">
                                                    <textarea name="body" rows="2" dir="auto" maxlength="10000" required class="as-input" aria-label="Reply to {{ $c.Author }}"></textarea>
                                                    <button type="submit" class="as-button size-sm self-start">Reply</button>
                                                </form>
                                            </details>
                                        {{ end }}
                                        {{ if $c.Mine }}
                                            <a href="{{ $page.URL }}/comments/{{ $c.ID }}/edit" hx-get="{{ $page.URL }}/comments/{{ $c.ID }}/edit" hx-target="#comment-{{ $c.ID }}" hx-select="#comment-{{ $c.ID }}" hx-swap="outerHTML" class="as-button size-sm variant-outlined">Edit</a>
                                            <a href="{{ $page.URL }}/comments/{{ $c.ID }}/delete" class="as-button size-sm variant-outlined is-danger">Delete</a>
                                        {{ end }}
                                    </div>
                                {{ end }}
                            {{ end }}
                        </article>
                    </li>
                {{ end }}
            </ol>
        {{ else }}
            <p class="as-hint">No comments yet.</p>
        {{ end }}
        {{ with .CommentError }}<p role="alert" class="as-alert variant-danger">{{ . }}</p>{{ end }}
        {{ if .CanComment }}
            <form method="post" action="{{ .URL }}/comments" class="flex flex-col gap-2">
                <label class="as-field">Comment
                    <textarea name="body" rows="3" dir="auto" maxlength="10000" required class="as-input"></textarea>
                </label>
                <button type="submit" class="as-button self-start">Comment</button>
            </form>
        {{ else if not .SignedIn }}
            <p class="as-hint"><a href="{{ .SignInURL }}">Sign in to comment</a></p>
        {{ end }}
    </section>
{{ end }}
{{ end }}
