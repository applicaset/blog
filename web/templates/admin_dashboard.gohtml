{{ define "content" }}
<dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    {{ if .CanManagePosts }}
        <div class="as-card"><dt class="text-sm text-muted">Published</dt><dd class="mt-1 text-2xl font-semibold">{{ .Published }}</dd></div>
        <div class="as-card"><dt class="text-sm text-muted">Drafts</dt><dd class="mt-1 text-2xl font-semibold">{{ .Drafts }}</dd></div>
        <div class="as-card"><dt class="text-sm text-muted">Archived</dt><dd class="mt-1 text-2xl font-semibold">{{ .Archived }}</dd></div>
    {{ end }}
    {{ if .CanManageUsers }}
        <div class="as-card"><dt class="text-sm text-muted">Users</dt><dd class="mt-1 text-2xl font-semibold">{{ .Users }}</dd></div>
    {{ end }}
</dl>
{{ if and .CanManagePosts (not .ShowingEveryone) }}<p class="as-hint -mt-3">These numbers cover your own posts.</p>{{ end }}

{{ if .CanManagePosts }}
    <section class="flex flex-col gap-3">
        <div class="flex items-baseline justify-between gap-4">
            <h2>Recent posts</h2>
            <a href="{{ path "/admin/posts" }}" >All posts</a>
        </div>
        {{ if .RecentPosts }}
            <ul class="divide-y divide-border border-y border-border">
                {{ range .RecentPosts }}
                    <li class="flex items-center gap-3 py-3">
                        <a href="{{ path "/posts/" }}{{ .ID }}" class="min-w-0 flex-1 truncate">{{ .Title }}</a>
                        {{ template "status-badge" .Status }}
                        <a href="{{ path "/admin/posts/" }}{{ .ID }}/edit" class="as-button variant-outlined size-sm">Edit</a>
                    </li>
                {{ end }}
            </ul>
        {{ else }}
            <p class="as-hint">There are no posts yet.</p>
        {{ end }}
    </section>
{{ end }}
{{ end }}
