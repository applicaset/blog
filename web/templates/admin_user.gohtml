{{ define "content" }}
<dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2">
    <dt class="text-muted">Username</dt><dd>{{ .User.Username }}</dd>
    <dt class="text-muted">Name</dt><dd>{{ .User.Name }}</dd>
</dl>
{{ if .IsSelf }}<p class="as-alert variant-info">This is your own account.</p>{{ end }}

{{ if .CanAssign }}
    <form method="post" action="{{ path "/admin/users/" }}{{ .User.ID }}/roles" class="flex flex-col gap-4">
        <fieldset class="flex flex-col gap-3">
            <legend class="mb-3 font-medium">Roles</legend>
            {{ $held := .HeldRoles }}
            {{ range .AllRoles }}
                <label class="as-check"><input type="checkbox" name="roles" value="{{ . }}" {{ if has $held . }}checked{{ end }}> {{ . }}</label>
            {{ end }}
        </fieldset>
        <div><button type="submit" class="as-button">Save roles</button></div>
    </form>
{{ else }}
    <p><span class="text-muted">Roles:</span> {{ range .HeldRoles }}{{ . }} {{ else }}none{{ end }}</p>
{{ end }}
{{ if .CanDelete }}
    <div class="border-t border-border pt-6">
        <a href="{{ path "/admin/users/" }}{{ .User.ID }}/delete" class="as-button is-danger">Delete</a>
    </div>
{{ end }}
<p><a href="{{ path "/admin/users" }}" class="as-back-link">{{ template "mdi-arrow-left.svg" }}Back to users</a></p>
{{ end }}
