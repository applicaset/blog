{{ define "content" }}
<form method="post" action="{{ if .Editing }}{{ path "/admin/posts/" }}{{ .Post.ID }}{{ else }}{{ path "/admin/posts" }}{{ end }}" class="flex flex-col gap-5">
    <label class="as-field">Title <input class="as-input" name="title" value="{{ .Post.Title }}" required autofocus maxlength="200"></label>
    <label class="as-field">Body <textarea class="as-input leading-relaxed" name="body" rows="20">{{ .Post.Body }}</textarea></label>
    <p class="as-hint -mt-3">Plain text. A blank line starts a new paragraph.</p>
    <div><button type="submit" class="as-button">{{ if .Editing }}Save{{ else }}Create draft{{ end }}</button></div>
</form>

{{ if .Editing }}
    <section class="flex flex-col gap-4 border-t border-border pt-6">
        <p class="flex items-center gap-2">Status {{ template "status-badge" .Post.Status }}</p>
        <div class="flex flex-wrap gap-2">
            {{ range .Statuses }}
                <form method="post" action="{{ path "/admin/posts/" }}{{ $.Post.ID }}/status">
                    <input type="hidden" name="status" value="{{ . }}">
                    <button type="submit" class="as-button variant-outlined">{{ transitionLabel . }}</button>
                </form>
            {{ end }}
            <a href="{{ path "/admin/posts/" }}{{ .Post.ID }}/delete" class="as-button is-danger">Delete</a>
        </div>
    </section>
{{ end }}
{{ end }}
